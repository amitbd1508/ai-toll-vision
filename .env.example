# Copy to .env and adjust as needed. Most settings live in config.yaml —
# this file only covers secrets/host-specific overrides.

# Hugging Face token, only needed if vlm.enabled=true and the model repo
# requires authentication.
HF_TOKEN=

# Override the port the API/dashboard listens on.
PORT=8000

# Force a specific device instead of auto-detection: cpu | cuda | mps
DEVICE_OVERRIDE=
